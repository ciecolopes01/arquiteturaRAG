# Copie este arquivo para .env e preencha os valores reais.
# Nunca versione o .env (já está no .gitignore).

# --- LLM (geração) ---
ANTHROPIC_API_KEY=

# --- Embedding (escolha um provider: voyage | openai | cohere) ---
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

# --- PostgreSQL (metadata + BM25 nesta fase) ---
POSTGRES_URL=postgresql://rag:rag_dev_password@localhost:5432/rag_platform

# --- MinIO (object storage, S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
