# Copie este arquivo para .env e preencha os valores reais.
# Nunca versione o .env (já está no .gitignore).

# --- LLM & Visão (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# --- OCR (Tesseract - opcional para OCR local de imagens) ---
TESSERACT_CMD=

# --- Embeddings & Reranker locais (BGE-M3 e BGE-Reranker-v2-m3) ---
EMBEDDING_DEVICE=cpu          # "cpu" | "cuda"
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K_CANDIDATES=20

# --- Qdrant (Vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
QDRANT_EF_SEARCH=64

# --- PostgreSQL (Metadata + BM25 tsvector) ---
# Em produção, altere a senha padrão de desenvolvimento:
POSTGRES_URL=postgresql://rag:rag_dev_password@localhost:5432/rag_platform

# --- MinIO (Object storage S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# --- Neo4j (Graph Search - Passo 28) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rag_neo4j_password

# --- Redis & Cache (Passo 32) ---
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=true
CACHE_RESPONSE_TTL=3600
CACHE_EMBEDDING_TTL=86400

# --- Auto-Tuning de Pesos de Fusão (Passo 30) ---
FUSION_TUNED_WEIGHTS={"dense": 1.2, "bm25": 1.0, "graph": 0.8}

# --- Ambiente de Execução ---
# Em produção, o sistema rejeita senhas padrão e exige credenciais seguras:
ENVIRONMENT=development        # "development" | "production" | "test"
